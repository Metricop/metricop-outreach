# Kopirati u .env.local (lokalno) ili upisati u Vercel → Settings → Environment Variables.
# Vrednosti se NIKAD ne upisuju u repozitorijum.

# Supabase → Project Settings → API (ili dugme "Connect")
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Claude API (personalizacija) - samo na serveru (Vercel), nikad u repozitorijumu.
ANTHROPIC_API_KEY=
